{
  "name": "perch",
  "version": "1.1.0",
  "description": "Perch: Twitch streams in a floating picture-in-picture window, with chat.",
  "license": "MIT",
  "repository": "github:andresmarpz/perch",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test src",
    "e2e": "bun run build && playwright test",
    "check": "bun run typecheck && bun run test && bun run build",
    "package": "bun scripts/package.ts"
  },
  "dependencies": {
    "effect": "4.1.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/bun": "latest",
    "@types/chrome": "latest",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "ws": "8.23.0"
  }
}
